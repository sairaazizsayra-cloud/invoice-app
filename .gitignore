# Release signing — never commit keystores or signing passwords.
# Place your own upload keystore outside the repo (or locally untracked)
# and point android/key.properties at it. See docs/RELEASE.md in a later phase.
key.properties
*.jks
*.keystore
*.p12
*.p8

# Environment secrets and private credentials
.env
.env.*
!.env.example

# Firebase Admin / service-account credentials (never commit)
**/serviceAccount*.json
**/*-firebase-adminsdk*.json
**/google-services-desktop.json
